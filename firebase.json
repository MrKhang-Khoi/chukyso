{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "destination": "https://chukyso.onrender.com/api/**"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
